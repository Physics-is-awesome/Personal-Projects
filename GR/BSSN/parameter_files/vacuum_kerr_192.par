# ==========================================================
# params.par — run-time parameter file for the BSSNOK/Cartoon
# Vacuum kerr
# ==========================================================

# --- Grid ---
nx   = 192        # points in x in [0, xmax], x(1) = 0
nz   = 384        # points in z in [-zmax, zmax]
xmax = 12.0      # in units of M
zmax = 12.0

# --- Black hole (Kerr-Schild) ---
bh_mass     = 1.0
bh_spin     = 0.8   ! a, with 0 <= |a| < bh_mass
bh_center_x = 0.0
bh_center_z = 0.0

# --- Star ---
star_center_x = 0.0
star_center_z = 0.0

# --- Gauge ---
gauge_eta = 2.0      # Gamma-driver damping, ~ 2/M

# --- Time evolution ---
cfl       = 0.005    # resolves the fastest 1+log/gauge characteristic
nsteps    = 1000000
out_every = 100
hz_every = 100
ko_eps    = 0.2   #0.2 is what it was   # Kreiss-Oliger dissipation strength, typical 0.1-0.5
r_excise  = 1.5      # route-C trumpet surface: R0 < r_excise < r_+
excision_order = 3   # bounded inner-boundary extension
excision_sat = false # guarded until exact BSSN characteristic data are available.
                    # The reduced SAT remains diagnostic-only; it is not a
                    # complete characteristic treatment for production BSSN.
initial_data_mode = 1 # Dennison-Baumgarte-Montero route-C trumpet data
slicing_mode = 3       # tabulated stationary Kerr slicing
gamma_driver_mode = 4  # matching non-advective Gamma driver
